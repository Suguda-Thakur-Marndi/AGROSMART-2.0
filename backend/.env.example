# AgroSmart 2.0 Backend Environment Configuration Template
# Copy this file to backend/.env and configure values before production deployment.

APP_NAME="AgroSmart 2.0 API"
SECRET_KEY=replace-with-a-secure-random-32-byte-hex-string
DATABASE_URL=sqlite+aiosqlite:///./agrosmart.db
DEVICE_API_KEY=replace-with-hardware-device-auth-key

VEG_MOISTURE_ON=35.0
VEG_MOISTURE_OFF=55.0
PADDY_MOISTURE_ON=60.0
PADDY_MOISTURE_OFF=80.0
