# AgroSmart 2.0 Environment Configuration Template
# Copy this file to .env and configure values before production deployment.

APP_NAME="AgroSmart 2.0 API"
# Generate a secure 32+ character key for JWT signing: openssl rand -hex 32
SECRET_KEY=replace-with-a-secure-random-32-byte-hex-string
# Database connection string (SQLite for dev/testing, PostgreSQL for production)
DATABASE_URL=sqlite+aiosqlite:///./agrosmart.db
# Hardware ESP8266/Arduino Device Authentication Key (X-Device-Key header)
DEVICE_API_KEY=replace-with-hardware-device-auth-key

# Irrigation Threshold Defaults (% moisture)
VEG_MOISTURE_ON=35.0
VEG_MOISTURE_OFF=55.0
PADDY_MOISTURE_ON=60.0
PADDY_MOISTURE_OFF=80.0
